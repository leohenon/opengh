{
  "name": "opengh",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "bin": {
    "opengh": "bin/opengh"
  },
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "site:build": "bun site/build.ts",
    "site:dev": "bun run site:build && bun site/serve.ts",
    "site:check": "tsc -p site/tsconfig.json && bun run site:build && bun site/check.ts"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@pierre/diffs": "1.3.5",
    "hast-util-to-html": "9.0.5",
    "hunkdiff": "0.24.0",
    "parse5": "7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "solid-js": "1.9.12",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "seroval": "1.6.3",
    "shell-quote": "1.11.0"
  },
  "patchedDependencies": {
    "@opentui/core@0.6.6": "patches/opentui-core@0.6.6.patch",
    "hunkdiff@0.24.0": "patches/hunkdiff@0.24.0.patch"
  }
}
