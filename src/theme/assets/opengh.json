{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#0d1117",
    "darkBgAlt": "#10161e",
    "darkBgPanel": "#161f2b",
    "darkFg": "#e6edf3",
    "darkFgMuted": "#9daabb",
    "darkBlue": "#79b8ff",
    "darkGreen": "#56d384",
    "darkRed": "#ff7b72",
    "darkOrange": "#f0b477",
    "darkPurple": "#bc9cff",
    "darkPink": "#f7a58b",
    "darkYellow": "#e3b341",
